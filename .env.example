ENVIRONMENT=local

# ─── Server ───────────────────────────────────────────────
SERVER_PORT=8443
SERVER_TLS_CERT_FILE=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
SERVER_TLS_KEY_FILE=/etc/letsencrypt/live/yourdomain.com/privkey.pem

# ─── vcita / inTandem ─────────────────────────────────────
VCITA_API_BASE=https://api.vcita.biz
VCITA_DIRECTORY_TOKEN=your_directory_token_here
VCITA_BUSINESS_TOKEN=your_business_token_here
VCITA_WEBHOOK_SECRET=your_webhook_signing_secret_here

# ─── Database ─────────────────────────────────────────────
DB_DRIVER=sqlite3
DB_DSN=file:data/vcita_agent.db?_journal=WAL&_foreign_keys=on

# ─── Encryption (HIPAA: AES-256-GCM for PHI fields) ───────
# Generate with: openssl rand -hex 32
PHI_ENCRYPTION_KEY=c6c7cde06d120082eb0a591d88f64e516ac7b8c18a5b45e4d44a7171f2d23721

# ─── Notifications ────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
SMTP_FROM=noreply@yourdomain.com
ALERT_EMAIL_TO=staff@yourdomain.com

# ─── AI Service (stub — filled in by AI developer) ────────
AI_SERVICE_URL=http://localhost:9000
AI_SERVICE_TOKEN=internal_service_token

# ─── Audit ────────────────────────────────────────────────
AUDIT_LOG_PATH=logs/audit.log
